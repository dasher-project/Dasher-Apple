    "All Dasher settings will be restored to their default values. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Dasher-Einstellungen werden auf ihre Standardwerte zurückgesetzt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Dasher-instellings sal na hul verstekwaardes herstel word. Dit kan nie ongedaan gemaak word nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم استعادة جميع إعدادات Dasher إلى قيمها الافتراضية. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ড্যাশার-এর সমস্ত সেটিংস তাদের ডিফল্ট মানে পুনরুদ্ধার করা হবে। এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechna nastavení Dasheru budou obnovena na výchozí hodnoty. Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Dasher-indstillinger vil blive gendannet til deres standardværdier. Dette kan ikke fortrydes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλες οι ρυθμίσεις του Dasher θα επανέλθουν στις προεπιλεγμένες τιμές τους. Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los ajustes de Dasher se restablecerán a sus valores predeterminados. Esta acción es irreversible."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تمام تنظیمات Dasher به مقادیر پیش‌فرض خود بازگردانده می‌شوند. این کار قابل بازگشت نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki Dasher-asetukset palautetaan oletusarvoihinsa. Tätä ei voi perua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les paramètres Dasher seront restaurés à leurs valeurs par défaut. Cela ne peut pas être annulé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધી ડેશર સેટિંગ્સ તેમના ડિફોલ્ટ મૂલ્યો પર પુનઃસ્થાપિત કરવામાં આવશે. આ પૂર્વવત્ કરી શકાતું નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डैशर की सभी सेटिंग्स उनके डिफ़ॉल्ट मानों पर वापस आ जाएंगी। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Dasher összes beállítása visszaáll az alapértelmezett értékre. Ez a művelet nem vonható vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le impostazioni di Dasher verranno ripristinate ai valori predefiniti. Questa operazione non può essere annullata."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲಾ ಡ್ಯಾಷರ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಅವುಗಳ ಡೀಫಾಲ್ಟ್ ಮೌಲ್ಯಗಳಿಗೆ ಮರುಸ್ಥಾಪಿಸಲಾಗುತ್ತದೆ. ಇದನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ ഡാഷർ ക്രമീകരണങ്ങളും അവയുടെ സ്ഥിര മൂല്യങ്ങളിലേക്ക് പുനഃസ്ഥാപിക്കപ്പെടും. ഇത് പഴയപടിയാക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व डॅशर सेटिंग्ज त्यांच्या मूळ मूल्यांवर पुनर्संचयित केल्या जातील. हा बदल पूर्ववत करता येणार नाही."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Dasher-instellingen worden teruggezet naar de standaardwaarden. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਰੀਆਂ ਡੈਸ਼ਰ ਸੈਟਿੰਗਾਂ ਨੂੰ ਉਹਨਾਂ ਦੇ ਪੂਰਵ-ਨਿਰਧਾਰਤ ਮੁੱਲਾਂ 'ਤੇ ਰੀਸਟੋਰ ਕੀਤਾ ਜਾਵੇਗਾ। ਇਸਨੂੰ ਅਣਕੀਤਾ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie ustawienia Dashera zostaną przywrócone do wartości domyślnych. Tej operacji nie można cofnąć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as configurações do Dasher serão restauradas aos valores padrão. Essa ação é irreversível."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as configurações do Dasher serão restauradas aos valores padrão. Essa ação é irreversível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все настройки Dasher будут восстановлены до значений по умолчанию. Это действие необратимо."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla Dasher-inställningar återställs till standardvärdena. Detta kan inte ångras."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mipangilio yote ya Dasher itarejeshwa kwenye thamani zake chaguo-msingi. Hii haiwezi kutenduliwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டேஷரின் அனைத்து அமைப்புகளும் அவற்றின் இயல்புநிலை மதிப்புகளுக்கு மீட்டமைக்கப்படும். இதை மீண்டும் பழைய நிலைக்குக் கொண்டுவர முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్ని డాషర్ సెట్టింగ్‌లు వాటి డిఫాల్ట్ విలువలకు పునరుద్ధరించబడతాయి. దీనిని రద్దు చేయడం సాధ్యపడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่า Dasher ทั้งหมดจะถูกคืนค่าเป็นค่าเริ่มต้น การเปลี่ยนแปลงนี้ไม่สามารถย้อนกลับได้"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیشر کی تمام ترتیبات ان کی ڈیفالٹ اقدار پر بحال ہو جائیں گی۔ اسے کالعدم نہیں کیا جا سکتا۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 Dasher 设置都将恢复为默认值。此操作无法撤消。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonke izilungiselelo ze-Dasher zizobuyiselwa kumanani azo azenzakalelayo. Lokhu akukwazi ukuhlehliswa."
          }
        }
      }
    },
