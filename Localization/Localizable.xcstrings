    "Restore all Dasher settings to their default values. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzen Sie alle Dasher-Einstellungen auf ihre Standardwerte zurück. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel alle Dasher-instellings terug na hul verstekwaardes. Dit kan nie ongedaan gemaak word nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد ضبط جميع إعدادات Dasher إلى قيمها الافتراضية. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ড্যাশার-এর সমস্ত সেটিংস ডিফল্ট মানে পুনরুদ্ধার করুন। এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovit všechna nastavení Dasheru na výchozí hodnoty. Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendan alle Dasher-indstillinger til deres standardværdier. Dette kan ikke fortrydes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρετε όλες τις ρυθμίσεις του Dasher στις προεπιλεγμένες τιμές τους. Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece todos los ajustes de Dasher a sus valores predeterminados. Esta acción es irreversible."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تمام تنظیمات Dasher را به مقادیر پیش‌فرضشان برگردانید. این کار قابل بازگشت نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauta kaikki Dasher-asetukset oletusarvoihinsa. Tätä ei voi perua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez tous les paramètres Dasher à leurs valeurs par défaut. Cela ne peut pas être annulé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધી ડેશર સેટિંગ્સને તેમના ડિફોલ્ટ મૂલ્યો પર પુનઃસ્થાપિત કરો. આ પૂર્વવત્ કરી શકાતું નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डैशर की सभी सेटिंग्स को उनके डिफ़ॉल्ट मानों पर पुनर्स्थापित करें। इसे पूर्ववत नहीं किया जा सकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összes Dasher-beállítás visszaállítása az alapértelmezett értékre. Ez a művelet nem vonható vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina tutte le impostazioni di Dasher ai valori predefiniti. Questa operazione non può essere annullata."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲಾ ಡ್ಯಾಷರ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಅವುಗಳ ಡೀಫಾಲ್ಟ್ ಮೌಲ್ಯಗಳಿಗೆ ಮರುಸ್ಥಾಪಿಸಿ. ಇದನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ ഡാഷർ ക്രമീകരണങ്ങളും അവയുടെ ഡിഫോൾട്ട് മൂല്യങ്ങളിലേക്ക് പുനഃസ്ഥാപിക്കുക. ഇത് പഴയപടിയാക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व डॅशर सेटिंग्ज त्यांच्या मूळ मूल्यांवर पुनर्संचयित करा. हे बदल पूर्ववत करता येणार नाहीत."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Dasher-instellingen worden teruggezet naar de standaardwaarden. Deze wijziging is onomkeerbaar."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਰੀਆਂ ਡੈਸ਼ਰ ਸੈਟਿੰਗਾਂ ਨੂੰ ਉਹਨਾਂ ਦੇ ਡਿਫੌਲਟ ਮੁੱਲਾਂ 'ਤੇ ਰੀਸਟੋਰ ਕਰੋ। ਇਸਨੂੰ ਅਣਕੀਤਾ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć wszystkie ustawienia Dashera do wartości domyślnych. Tej czynności nie można cofnąć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure todas as configurações do Dasher aos valores padrão. Esta ação é irreversível."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure todas as configurações do Dasher aos valores padrão. Esta ação é irreversível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановите все настройки Dasher до значений по умолчанию. Это действие необратимо."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställ alla Dasher-inställningar till standardvärdena. Detta kan inte ångras."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejesha mipangilio yote ya Dasher kwenye thamani zake chaguo-msingi. Hii haiwezi kutenduliwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டேஷரின் அனைத்து அமைப்புகளையும் அவற்றின் இயல்புநிலை மதிப்புகளுக்கு மீட்டமைக்கவும். இதை மீண்டும் பழைய நிலைக்குக் கொண்டுவர முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్ని డాషర్ సెట్టింగ్‌లను వాటి డిఫాల్ట్ విలువలకు పునరుద్ధరించండి. దీన్ని రద్దు చేయడం సాధ్యపడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนค่าการตั้งค่า Dasher ทั้งหมดกลับเป็นค่าเริ่มต้น การดำเนินการนี้ไม่สามารถย้อนกลับได้"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیشر کی تمام ترتیبات کو ان کی ڈیفالٹ اقدار پر بحال کریں۔ اسے کالعدم نہیں کیا جا سکتا۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将所有 Dasher 设置恢复为默认值。此操作无法撤消。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Buyisela zonke izilungiselelo ze-Dasher kumanani azo azenzakalelayo. Lokhu akukwazi ukuhlehliswa."
          }
        }
      }
    },
