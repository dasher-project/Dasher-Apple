    "Dasher 5 data detected on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher 5-Daten wurden auf diesem Mac erkannt."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher 5-data is op hierdie Mac opgespoor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اكتشاف بيانات Dasher 5 على هذا الجهاز Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ম্যাক-এ ড্যাশার ৫ ডেটা শনাক্ত করা হয়েছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tomto Macu byla nalezena data z Dasheru 5."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher 5-data fundet på denne Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εντοπίστηκαν δεδομένα Dasher 5 σε αυτόν τον Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han detectado datos de Dasher 5 en este Mac."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های Dasher 5 روی این مک شناسایی شد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher 5 -tietoja havaittu tällä Macilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données Dasher 5 détectées sur ce Mac."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ Mac પર Dasher 5 ડેટા મળ્યો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मैक पर डैशर 5 का डेटा पाया गया है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher 5 adatok észlelve ezen a Mac gépen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati Dasher 5 rilevati su questo Mac."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ Mac ನಲ್ಲಿ Dasher 5 ಡೇಟಾ ಪತ್ತೆಯಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ മാക്കിൽ ഡാഷർ 5 ഡാറ്റ കണ്ടെത്തി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या मॅकवर डॅशर ५ चा डेटा आढळला आहे."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher 5-gegevens gedetecteerd op deze Mac."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਮੈਕ 'ਤੇ ਡੈਸ਼ਰ 5 ਡਾਟਾ ਖੋਜਿਆ ਗਿਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym Macu wykryto dane Dasher 5."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados do Dasher 5 detectados neste Mac."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados do Dasher 5 detectados neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом Mac обнаружены данные Dasher 5."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher 5-data upptäcktes på denna Mac."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Data ya Dasher 5 imegunduliwa kwenye Mac hii."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த மேக்கில் டேஷர் 5 தரவு கண்டறியப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ Macలో డాషర్ 5 డేటా గుర్తించబడింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจพบข้อมูล Dasher 5 บนเครื่อง Mac นี้"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس میک پر ڈیشر 5 ڈیٹا کا پتہ چلا۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 Mac 上检测到 Dasher 5 数据。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Idatha ye-Dasher 5 itholakele kule Mac."
          }
        }
      }
    },
    "Dasher 5 settings imported successfully.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher 5-Einstellungen erfolgreich importiert."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher 5-instellings suksesvol ingevoer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استيراد إعدادات Dasher 5 بنجاح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ড্যাশার ৫-এর সেটিংস সফলভাবে ইম্পোর্ট করা হয়েছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení Dasheru 5 bylo úspěšně importováno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher 5-indstillinger blev importeret."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ρυθμίσεις του Dasher 5 εισήχθησαν με επιτυχία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
