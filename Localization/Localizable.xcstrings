            "value": "Dasher 5 کی ترتیبات کامیابی کے ساتھ درآمد ہو گئیں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher 5 设置已成功导入。"
          }
        },
        "zu": {
