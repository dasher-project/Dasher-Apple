    "Enable Dasher under Settings → General → Keyboard → Keyboards, then turn on Allow Full Access so Dasher can speak and learn.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie Dasher unter Einstellungen → Allgemein → Tastatur → Tastaturen und aktivieren Sie dann Vollzugriff zulassen, damit Dasher sprechen und lernen kann."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiveer Dasher onder Instellings → Algemeen → Sleutelbord → Sleutelborde, en skakel dan Laat Volle Toegang Toe aan sodat Dasher kan praat en leer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتمكين Dasher من خلال الإعدادات → عام → لوحة المفاتيح → لوحات المفاتيح، ثم قم بتشغيل السماح بالوصول الكامل حتى يتمكن Dasher من التحدث والتعلم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংস → সাধারণ → কীবোর্ড → কীবোর্ডস-এ গিয়ে ড্যাশার সক্রিয় করুন, তারপর সম্পূর্ণ অ্যাক্সেসের অনুমতি দিন (Allow Full Access) চালু করুন, যাতে ড্যাশার কথা বলতে ও শিখতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte Dasher v Nastavení → Obecné → Klávesnice → Klávesnice a poté zapněte Povolit plný přístup, aby Dasher mohl mluvit a učit se."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivér Dasher under Indstillinger → Generelt → Tastatur → Tastaturer, og aktivér derefter Tillad fuld adgang, så Dasher kan tale og lære."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε το Dasher στις Ρυθμίσεις → Γενικά → Πληκτρολόγιο → Πληκτρολόγια και, στη συνέχεια, ενεργοποιήστε την επιλογή Να επιτρέπεται η πλήρης πρόσβαση, ώστε το Dasher να μπορεί να μιλάει και να μαθαίνει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilita Dasher en Ajustes → General → Teclado → Teclados y, a continuación, activa la opción Permitir acceso completo para que Dasher pueda hablar y aprender."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher را از طریق مسیر تنظیمات → عمومی → صفحه‌کلید → صفحه‌کلید فعال کنید، سپس گزینه «اجازه دسترسی کامل» را فعال کنید تا Dasher بتواند صحبت کند و یاد بگیرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota Dasher käyttöön kohdassa Asetukset → Yleiset → Näppäimistö → Näppäimistöt ja ota sitten käyttöön Salli täysi käyttöoikeus, jotta Dasher voi puhua ja oppia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Dasher sous Paramètres → Général → Clavier → Claviers, puis activez Autoriser l'accès complet pour que Dasher puisse parler et apprendre."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સેટિંગ્સ → જનરલ → કીબોર્ડ → કીબોર્ડ્સ હેઠળ ડેશરને સક્ષમ કરો, પછી પૂર્ણ ઍક્સેસને મંજૂરી આપો ચાલુ કરો જેથી ડેશર બોલી અને શીખી શકે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स → सामान्य → कीबोर्ड → कीबोर्ड के अंतर्गत डैशर को सक्षम करें, फिर पूर्ण पहुंच की अनुमति दें को चालू करें ताकि डैशर बोल सके और सीख सके।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze a Dashert a Beállítások → Általános → Billentyűzet → Billentyűzetek menüpontban, majd kapcsolja be a Teljes hozzáférés engedélyezése beállítást, hogy a Dasher beszélhessen és tanulhasson."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita Dasher in Impostazioni → Generali → Tastiera → Tastiere, quindi attiva Consenti accesso completo in modo che Dasher possa parlare e imparare."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೆಟ್ಟಿಂಗ್‌ಗಳು → ಸಾಮಾನ್ಯ → ಕೀಬೋರ್ಡ್ → ಕೀಬೋರ್ಡ್‌ಗಳು ಅಡಿಯಲ್ಲಿ ಡ್ಯಾಷರ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ, ನಂತರ ಡ್ಯಾಷರ್ ಮಾತನಾಡಲು ಮತ್ತು ಕಲಿಯಲು ಪೂರ್ಣ ಪ್ರವೇಶವನ್ನು ಅನುಮತಿಸಿ ಆನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്രമീകരണങ്ങൾ → പൊതുവായത് → കീബോർഡ് → കീബോർഡുകൾ എന്നതിന് കീഴിൽ ഡാഷർ പ്രവർത്തനക്ഷമമാക്കുക, തുടർന്ന് ഡാഷറിന് സംസാരിക്കാനും പഠിക്കാനും കഴിയുന്ന തരത്തിൽ പൂർണ്ണ ആക്‌സസ് അനുവദിക്കുക ഓണാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्ज → जनरल → कीबोर्ड → कीबोर्ड्स अंतर्गत डॅशर सक्षम करा, त्यानंतर 'पूर्ण प्रवेशास अनुमती द्या' (Allow Full Access) चालू करा जेणेकरून डॅशर बोलू आणि शिकू शकेल."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Dasher in via Instellingen → Algemeen → Toetsenbord → Toetsenborden en zet vervolgens 'Volledige toegang toestaan' aan, zodat Dasher kan spreken en leren."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੈਟਿੰਗਾਂ → ਜਨਰਲ → ਕੀਬੋਰਡ → ਕੀਬੋਰਡ ਦੇ ਅਧੀਨ ਡੈਸ਼ਰ ਨੂੰ ਸਮਰੱਥ ਬਣਾਓ, ਫਿਰ ਪੂਰੀ ਪਹੁੰਚ ਦੀ ਆਗਿਆ ਦਿਓ ਨੂੰ ਚਾਲੂ ਕਰੋ ਤਾਂ ਜੋ ਡੈਸ਼ਰ ਬੋਲ ਸਕੇ ਅਤੇ ਸਿੱਖ ਸਕੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Dasher w Ustawieniach → Ogólne → Klawiatura → Klawiatury, a następnie włącz opcję Zezwalaj na pełny dostęp, aby Dasher mógł mówić i się uczyć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Dasher em Configurações → Geral → Teclado → Teclados e, em seguida, habilite \"Permitir acesso total\" para que o Dasher possa falar e aprender."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Dasher em Configurações → Geral → Teclado → Teclados e, em seguida, habilite \"Permitir acesso total\" para que o Dasher possa falar e aprender."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Dasher в разделе «Настройки» → «Общие» → «Клавиатура» → «Клавиатуры», затем включите параметр «Разрешить полный доступ», чтобы Dasher мог говорить и учиться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera Dasher under Inställningar → Allmänt → Tangentbord → Tangentbord och slå sedan på Tillåt fullständig åtkomst så att Dasher kan tala och lära sig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa Kidhibiti cha Dashi chini ya Mipangilio → Jumla → Kibodi → Kibodi, kisha washa Ruhusu Ufikiaji Kamili ili Kidhibiti cha Dashi kiweze kuzungumza na kujifunza."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகள் → பொது → விசைப்பலகை → விசைப்பலகைகள் என்பதற்குச் சென்று டேஷரை இயக்கவும், பின்னர் முழு அணுகலை அனுமதி என்பதை இயக்கவும், இதன்மூலம் டேஷர் பேசவும் கற்றுக்கொள்ளவும் முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెట్టింగ్స్ → జనరల్ → కీబోర్డ్ → కీబోర్డ్స్ కింద డాషర్‌ను ఎనేబుల్ చేసి, ఆ తర్వాత 'అలో ఫుల్ యాక్సెస్' ను ఆన్ చేయండి, తద్వారా డాషర్ మాట్లాడగలదు మరియు నేర్చుకోగలదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้งาน Dasher ในการตั้งค่า → ทั่วไป → แป้นพิมพ์ → แป้นพิมพ์ จากนั้นเปิด \"อนุญาตการเข้าถึงแบบเต็ม\" เพื่อให้ Dasher สามารถพูดและเรียนรู้ได้"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیشر کو ترتیبات → جنرل → کی بورڈ → کی بورڈز کے تحت فعال کریں، پھر مکمل رسائی کی اجازت کو آن کریں تاکہ ڈیشر بول اور سیکھ سکے۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”→“常规”→“键盘”→“键盘”下启用 Dasher，然后打开“允许完全访问”，以便 Dasher 可以说话和学习。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nika amandla i-Dasher ngaphansi kwezilungiselelo → Okuvamile → Ikhibhodi → Amakhibhodi, bese uvula i-Vumela Ukufinyelela Okugcwele ukuze i-Dasher ikwazi ukukhuluma nokufunda."
          }
        }
      }
    },
    "Enable tilt input first to access calibration.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie zunächst die Neigungseingabe, um auf die Kalibrierung zuzugreifen."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiveer eers kantelinvoer om toegang tot kalibrasie te verkry."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتمكين إدخال الإمالة أولاً للوصول إلى المعايرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালিব্রেশন অ্যাক্সেস করতে প্রথমে টিল্ট ইনপুট সক্রিয় করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro přístup ke kalibraci nejprve povolte vstup náklonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver først hældningsinput for at få adgang til kalibrering."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε πρώτα την εισαγωγή κλίσης για να αποκτήσετε πρόσβαση στη βαθμονόμηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para acceder a la calibración, primero debe habilitar la entrada de inclinación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای دسترسی به کالیبراسیون، ابتدا ورودی شیب را فعال کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota kallistustulo ensin käyttöön päästäksesi kalibrointiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez d’abord la saisie de l’inclinaison pour accéder à l’étalonnage."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કેલિબ્રેશન ઍક્સેસ કરવા માટે પહેલા ટિલ્ટ ઇનપુટ સક્ષમ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलिब्रेशन तक पहुंचने के लिए पहले टिल्ट इनपुट को सक्षम करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kalibráció eléréséhez először engedélyezze a dőlésszög bemenetét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilitare prima l'input dell'inclinazione per accedere alla calibrazione."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಾಪನಾಂಕ ನಿರ್ಣಯವನ್ನು ಪ್ರವೇಶಿಸಲು ಮೊದಲು ಟಿಲ್ಟ್ ಇನ್‌ಪುಟ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാലിബ്രേഷൻ ആക്‌സസ് ചെയ്യുന്നതിന് ആദ്യം ടിൽറ്റ് ഇൻപുട്ട് പ്രവർത്തനക്ഷമമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅलिब्रेशन ऍक्सेस करण्यासाठी सर्वप्रथम टिल्ट इनपुट सक्षम करा."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel eerst de kantelinput in om toegang te krijgen tot de kalibratie."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੈਲੀਬ੍ਰੇਸ਼ਨ ਤੱਕ ਪਹੁੰਚ ਕਰਨ ਲਈ ਪਹਿਲਾਂ ਟਿਲਟ ਇਨਪੁੱਟ ਨੂੰ ਸਮਰੱਥ ਬਣਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby uzyskać dostęp do kalibracji, najpierw włącz wejście pochylenia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro, habilite a entrada de inclinação para acessar a calibração."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro, habilite a entrada de inclinação para acessar a calibração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для доступа к калибровке сначала включите ввод данных о наклоне."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera lutningsinmatning först för att komma åt kalibrering."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa ingizo la kuinamisha kwanza ili kufikia urekebishaji."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அளவுத்திருத்தத்தை அணுக, முதலில் சாய்வு உள்ளீட்டை இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాలిబ్రేషన్‌ను యాక్సెస్ చేయడానికి ముందుగా టిల్ట్ ఇన్‌పుట్‌ను ఎనేబుల్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้งานการป้อนข้อมูลการเอียงก่อนเพื่อเข้าถึงการปรับเทียบ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلیبریشن تک رسائی کے لیے پہلے جھکاؤ ان پٹ کو فعال کریں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "首先启用倾斜输入以访问校准。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nika amandla okokufaka kokuthambekela kuqala ukuze ufinyelele ekulinganisweni."
          }
        }
      }
    },
