    "No Dasher 5 data found on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac wurden keine Dasher 5-Daten gefunden."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen Dasher 5-data op hierdie Mac gevind nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على بيانات Dasher 5 على هذا الجهاز Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ম্যাক-এ কোনো ড্যাশার ৫ ডেটা পাওয়া যায়নি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tomto Macu nebyla nalezena žádná data pro Dasher 5."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen Dasher 5-data fundet på denne Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκαν δεδομένα Dasher 5 σε αυτόν τον Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron datos de Dasher 5 en esta Mac."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ داده‌ای از Dasher 5 در این مک یافت نشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tältä Macilta ei löytynyt Dasher 5 -tietoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée Dasher 5 trouvée sur ce Mac."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ Mac પર કોઈ Dasher 5 ડેટા મળ્યો નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मैक पर डैशर 5 का कोई डेटा नहीं मिला।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem találhatók Dasher 5 adatok ezen a Mac gépen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun dato Dasher 5 trovato su questo Mac."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ Mac ನಲ್ಲಿ ಯಾವುದೇ Dasher 5 ಡೇಟಾ ಕಂಡುಬಂದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ മാക്കിൽ ഡാഷർ 5 ഡാറ്റയൊന്നും കണ്ടെത്തിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या मॅकवर डॅशर ५ चा कोणताही डेटा आढळला नाही."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen Dasher 5-gegevens gevonden op deze Mac."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਮੈਕ 'ਤੇ ਕੋਈ ਡੈਸ਼ਰ 5 ਡਾਟਾ ਨਹੀਂ ਮਿਲਿਆ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono danych Dasher 5 na tym Macu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum dado do Dasher 5 foi encontrado neste Mac."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum dado do Dasher 5 foi encontrado neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные Dasher 5 на этом Mac не найдены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga Dasher 5-data hittades på den här Mac-datorn."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna data ya Dasher 5 iliyopatikana kwenye Mac hii."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த மேக்கில் டேஷர் 5 தரவு எதுவும் காணப்படவில்லை."
