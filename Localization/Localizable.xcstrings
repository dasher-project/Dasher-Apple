    "Pinch and hold anywhere on the canvas to start": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken und halten Sie zum Starten eine beliebige Stelle auf der Leinwand"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Knyp en hou enige plek op die doek vas om te begin"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مع الاستمرار في الضغط في أي مكان على اللوحة للبدء"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু করতে ক্যানভাসের যেকোনো জায়গায় চিমটি দিয়ে ধরে রাখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spusťte stisknutím a podržením libovolného místa na plátně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knib og hold et vilkårligt sted på lærredet for at starte"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τσιμπήστε και κρατήστε πατημένο οπουδήποτε στον καμβά για να ξεκινήσετε"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para empezar, pellizque y mantenga presionado en cualquier parte del lienzo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای شروع، هر جایی از بوم را به هم نزدیک کرده و نگه دارید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita nipistämällä ja pitämällä painettuna mitä tahansa kankaalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pincez et maintenez n'importe où sur la toile pour commencer"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શરૂ કરવા માટે કેનવાસ પર ગમે ત્યાં પિંચ કરો અને પકડી રાખો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैनवास पर कहीं भी चुटकी लेकर पकड़ें और शुरू करें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csippentsd össze és tartsd lenyomva az ujjad a vásznon bárhol a kezdéshez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per iniziare, pizzica e tieni premuto in un punto qualsiasi della tela"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಾರಂಭಿಸಲು ಕ್ಯಾನ್ವಾಸ್‌ನಲ್ಲಿ ಎಲ್ಲಿಯಾದರೂ ಪಿಂಚ್ ಮಾಡಿ ಮತ್ತು ಹಿಡಿದುಕೊಳ್ಳಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരംഭിക്കാൻ ക്യാൻവാസിൽ എവിടെയെങ്കിലും പിഞ്ച് ചെയ്ത് പിടിക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरुवात करण्यासाठी कॅनव्हासवर कुठेही चिमटा घ्या आणि धरून ठेवा."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knijp en houd ergens op het doek vast om te beginnen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਕੈਨਵਸ 'ਤੇ ਕਿਤੇ ਵੀ ਚੂੰਢੀ ਭਰ ਕੇ ਰੱਖੋ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby rozpocząć, ściśnij i przytrzymaj dowolne miejsce na płótnie"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para começar, faça um gesto de pinça e segure em qualquer lugar da tela."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para começar, faça um gesto de pinça e segure em qualquer lugar da tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для начала сожмите и удерживайте любую точку на холсте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyp och håll var som helst på arbetsytan för att börja"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bana na ushikilie popote kwenye turubai ili uanze"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடங்குவதற்கு கேன்வாஸில் எந்த இடத்திலும் கிள்ளி பிடித்துக் கொள்ளவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రారంభించడానికి కాన్వాస్‌పై ఎక్కడైనా చిటికెడు పట్టుకుని ఉంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บีบและกดค้างไว้ที่ใดก็ได้บนผืนผ้าใบเพื่อเริ่มต้น"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع کرنے کے لیے کینوس پر کہیں بھی چٹکی لگائیں اور پکڑیں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "捏住画布上的任意位置即可开始"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Cindezela bese ubamba noma kuphi kukhanvasi ukuze uqale"
          }
        }
      }
    },
