          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni di Dasher 5 importate correttamente."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಡ್ಯಾಷರ್ 5 ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಯಶಸ್ವಿಯಾಗಿ ಆಮದು ಮಾಡಿಕೊಳ್ಳಲಾಗಿದೆ."
          }
        },
        "ml": {
