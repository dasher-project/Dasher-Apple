    "Dasher needs accessibility access to send text to other applications.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher benötigt Barrierefreiheit, um Text an andere Anwendungen senden zu können."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher benodig toeganklikheidstoegang om teks na ander toepassings te stuur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج تطبيق Dasher إلى إمكانية الوصول لذوي الاحتياجات الخاصة لإرسال الرسائل النصية إلى التطبيقات الأخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্যান্য অ্যাপ্লিকেশনে টেক্সট পাঠাতে ড্যাশারের অ্যাক্সেসিবিলিটি অ্যাক্সেস প্রয়োজন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher potřebuje přístup k přístupu, aby mohl posílat textové zprávy do jiných aplikací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher skal have adgang til tilgængelighed for at sende tekst til andre apps."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Dasher χρειάζεται πρόσβαση προσβασιμότητας για να στείλει κείμενο σε άλλες εφαρμογές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher necesita acceso de accesibilidad para enviar texto a otras aplicaciones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دشر برای ارسال متن به برنامه‌های دیگر به دسترسی دسترسی نیاز دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher tarvitsee esteettömyysoikeudet lähettääkseen tekstiä muihin sovelluksiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher a besoin d'un accès d'accessibilité pour envoyer du texte à d'autres applications."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અન્ય એપ્લિકેશનોને ટેક્સ્ટ મોકલવા માટે ડેશરને ઍક્સેસિબિલિટી ઍક્સેસની જરૂર છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher को अन्य एप्लिकेशनों को टेक्स्ट भेजने के लिए एक्सेसिबिलिटी एक्सेस की आवश्यकता होती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Dashernek akadálymentes hozzáférésre van szüksége ahhoz, hogy szöveget küldhessen más alkalmazásokba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher necessita dell'accesso con accessibilità per inviare testo ad altre applicazioni."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇತರ ಅಪ್ಲಿಕೇಶನ್‌ಗಳಿಗೆ ಪಠ್ಯವನ್ನು ಕಳುಹಿಸಲು ಡ್ಯಾಷರ್‌ಗೆ ಪ್ರವೇಶದ ಪ್ರವೇಶದ ಅಗತ್ಯವಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റ് ആപ്ലിക്കേഷനുകളിലേക്ക് ടെക്സ്റ്റ് അയയ്ക്കാൻ ഡാഷറിന് പ്രവേശനക്ഷമത ആക്‌സസ് ആവശ്യമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इतर ॲप्लिकेशन्सना मजकूर पाठवण्यासाठी डॅशरला ॲक्सेसिबिलिटी ॲक्सेसची आवश्यकता आहे."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher heeft toegankelijkheidstoegang nodig om tekst naar andere applicaties te kunnen verzenden."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਡੈਸ਼ਰ ਨੂੰ ਹੋਰ ਐਪਲੀਕੇਸ਼ਨਾਂ ਨੂੰ ਟੈਕਸਟ ਭੇਜਣ ਲਈ ਪਹੁੰਚਯੋਗਤਾ ਪਹੁੰਚ ਦੀ ਲੋੜ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher potrzebuje uprawnień dostępu, aby móc wysyłać teksty do innych aplikacji."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher precisa de permissão de acessibilidade para enviar mensagens de texto para outros aplicativos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher precisa de permissão de acessibilidade para enviar mensagens de texto para outros aplicativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для отправки текстовых сообщений в другие приложения Daher требует наличия специальных прав."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher behöver åtkomst för att skicka text till andra appar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher inahitaji ufikiaji ili kutuma maandishi kwa programu zingine."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்ற பயன்பாடுகளுக்கு உரையை அனுப்ப, டாஷருக்கு அணுகல்தன்மை தேவைப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇతర అప్లికేషన్‌లకు టెక్స్ట్ పంపడానికి డాషర్‌కు యాక్సెసిబిలిటీ యాక్సెస్ అవసరం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher จำเป็นต้องได้รับสิทธิ์การเข้าถึงเพื่อส่งข้อความไปยังแอปพลิเคชันอื่น"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیشر کو دیگر ایپلیکیشنز کو ٹیکسٹ بھیجنے کے لیے قابل رسائی رسائی درکار ہے۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher 需要辅助访问权限才能将文本发送到其他应用程序。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Dasher idinga ukufinyelela kokufinyelela ukuze ithumele umbhalo kwezinye izinhlelo zokusebenza."
          }
        }
      }
    },
    "Dasher quit unexpectedly": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher gab unerwartet auf"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasher het onverwags opgehou"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استقال داشر بشكل غير متوقع"
          }
        },
        "bn": {
