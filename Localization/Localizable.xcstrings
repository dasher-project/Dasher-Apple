    "Tilt your device through its full range of motion during calibration.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neigen Sie Ihr Gerät während der Kalibrierung über den gesamten Bewegungsbereich."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kantel jou toestel deur sy volle bewegingsreeks tydens kalibrasie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإمالة جهازك عبر نطاق حركته الكامل أثناء المعايرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালিব্রেশনের সময় আপনার ডিভাইসটিকে এর সম্পূর্ণ গতিসীমা জুড়ে কাত করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během kalibrace naklánějte zařízení v celém rozsahu jeho pohybu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vip din enhed gennem hele dens bevægelsesområde under kalibrering."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γείρετε τη συσκευή σας σε όλο το εύρος κίνησής της κατά τη διάρκεια της βαθμονόμησης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclina tu dispositivo en todo su rango de movimiento durante la calibración."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در طول کالیبراسیون، دستگاه خود را در تمام دامنه حرکتی آن کج کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kallista laitettasi koko liikeradalla kalibroinnin aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclinez votre appareil sur toute sa gamme de mouvements pendant l'étalonnage."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કેલિબ્રેશન દરમિયાન તમારા ઉપકરણને તેની સંપૂર્ણ ગતિ શ્રેણીમાં ટિલ્ટ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलिब्रेशन के दौरान अपने डिवाइस को उसकी पूरी गति सीमा तक झुकाएं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalibrálás közben döntse meg a készüléket teljes mozgástartományában."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclina il tuo dispositivo per tutta la sua gamma di movimento durante la calibrazione."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಾಪನಾಂಕ ನಿರ್ಣಯದ ಸಮಯದಲ್ಲಿ ನಿಮ್ಮ ಸಾಧನವನ್ನು ಅದರ ಪೂರ್ಣ ವ್ಯಾಪ್ತಿಯ ಚಲನೆಯ ಮೂಲಕ ಓರೆಯಾಗಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാലിബ്രേഷൻ സമയത്ത് നിങ്ങളുടെ ഉപകരണം അതിന്റെ പൂർണ്ണ ചലന പരിധിയിലൂടെ ചരിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅलिब्रेशन दरम्यान आपले डिव्हाइस त्याच्या हालचालीच्या पूर्ण मर्यादेपर्यंत झुकवा."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kantel uw apparaat tijdens de kalibratie door het volledige bewegingsbereik."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੈਲੀਬ੍ਰੇਸ਼ਨ ਦੌਰਾਨ ਆਪਣੀ ਡਿਵਾਈਸ ਨੂੰ ਇਸਦੀ ਪੂਰੀ ਗਤੀ ਰੇਂਜ ਵਿੱਚ ਝੁਕਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas kalibracji przechylaj urządzenie w pełnym zakresie ruchu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a calibração, incline o dispositivo em toda a sua amplitude de movimento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a calibração, incline o dispositivo em toda a sua amplitude de movimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время калибровки наклоняйте устройство в полном диапазоне его движений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Luta enheten genom hela dess rörelseomfång under kalibreringen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tembeza kifaa chako kupitia mwendo wake wote wakati wa urekebishaji."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அளவுத்திருத்தத்தின் போது உங்கள் சாதனத்தை அதன் முழு இயக்க வரம்பிலும் சாய்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్రమాంకనం సమయంలో మీ పరికరాన్ని దాని పూర్తి కదలిక పరిధిలో వంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระหว่างการปรับเทียบ ให้เอียงอุปกรณ์ของคุณให้สุดช่วงการเคลื่อนไหว"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انشانکن کے دوران اپنے آلے کو حرکت کی پوری رینج کے ذریعے جھکائیں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在校准过程中，在整个运动范围内倾斜您的设备。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tshekisa idivayisi yakho phakathi nobubanzi bayo obuphelele bokunyakaza ngesikhathi sokulinganisa."
          }
        }
      }
    },
