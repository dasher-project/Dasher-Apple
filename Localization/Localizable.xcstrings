    "Move your eyes while pinching to steer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegen Sie Ihre Augen, während Sie zum Lenken kneifen"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweeg jou oë terwyl jy knyp om te stuur"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرك عينيك أثناء الضغط على زر التكبير/التصغير للتوجيه"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালনা করার জন্য চিমটি কাটার সাথে সাথে চোখ নাড়াচাড়া করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohybujte očima při sevření prstů pro řízení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevæg dine øjne, mens du kniber for at styre"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κουνήστε τα μάτια σας ενώ τσιμπάτε για να οδηγήσετε"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve los ojos mientras pellizcas para dirigir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای هدایت، هنگام نیشگون گرفتن، چشمان خود را حرکت دهید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikuta silmiäsi samalla nipistämällä ohjataksesi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bougez vos yeux en pinçant pour diriger"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પિંચિંગ કરતી વખતે તમારી આંખો ખસેડો અને સ્ટીયર કરો"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टीयरिंग के लिए पिंच करते समय अपनी आंखें हिलाएं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mozgasd a szemed, miközben csippentve irányítod az ujjaidat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muovi gli occhi mentre pizzichi per sterzare"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಟಿಯರ್ ಮಾಡಲು ಚಿವುಟುವಾಗ ನಿಮ್ಮ ಕಣ್ಣುಗಳನ್ನು ಸರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്റ്റിയർ ചെയ്യാൻ നുള്ളുമ്പോൾ കണ്ണുകൾ ചലിപ്പിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दिशा बदलण्यासाठी चिमटा घेताना तुमचे डोळे फिरवा."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweeg je ogen terwijl je met je ogen knijpt om te sturen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਟੀਅਰ ਕਰਨ ਲਈ ਚੂੰਢੀ ਭਰਦੇ ਹੋਏ ਆਪਣੀਆਂ ਅੱਖਾਂ ਨੂੰ ਹਿਲਾਓ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poruszaj oczami, jednocześnie ściskając je, aby sterować"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova os olhos enquanto usa o gesto de pinça para direcionar a câmera."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova os olhos enquanto usa o gesto de pinça para direcionar a câmera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещайте глаза, одновременно используя жест масштабирования для управления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rör ögonen medan du nyper för att styra"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sogeza macho yako huku ukibana ili kuongoza"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திசை திருப்புவதற்கு, விரல்களை நெரித்தவாறே உங்கள் கண்களை நகர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్టీరింగ్ చేయడానికి చిటికెన వేలుతో నొక్కుతున్నప్పుడు మీ కళ్ళను కదిలించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขยับดวงตาไปพร้อมกับบีบนิ้วเพื่อบังคับทิศทาง"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسٹیئر کرنے کے لیے چوٹکی لگاتے ہوئے اپنی آنکھوں کو حرکت دیں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "移动眼睛，同时捏住转向"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hambisa amehlo akho ngenkathi ucindezela ukuze uqondise"
          }
        }
      }
    },
